PORT=3000
# Postgres URL, or pglite://memory / pglite://./data/pglite for an embedded database.
DATABASE_URL=postgres://trail:trail@localhost:5432/trail
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
PUBLIC_BASE_URL=http://localhost:3000

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=
# Pay asset as CODE:ISSUER (USDC on mainnet: USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN)
PAY_ASSET=

# Platform keys. In production these come from a KMS/HSM, not env vars.
FEE_SECRET=
ADMIN_SECRET=
PLATFORM_SECRET=
TREASURY_SECRET=
# 32 bytes, base64. Encrypts custodial receiver keys (decision D1 option B).
RECEIVER_KEY_ENCRYPTION_KEY=
# Dev cash-out: the mock anchor's receiving account.
MOCK_ANCHOR_ACCOUNT=

SEED_ADMIN_EMAIL=ops@example.com
SEED_ADMIN_PASSWORD=change-me

# Spec placeholders
OFFLINE_MAX_HOURS=12
OFFLINE_GAP_FLAG_SECONDS=600
FEE_ALERT_XLM=50
PROOF_LINK_DAYS=30
# Hours after the delivery window closes before the driver can claim an unsigned final leg (default deadline).
DELIVERY_SIGN_HOURS=24
INDEXER_INTERVAL_MS=15000
